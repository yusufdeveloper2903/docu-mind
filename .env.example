# PostgreSQL 16+ with the pgvector extension
DATABASE_URL=postgres://postgres:postgres@localhost:5432/documind

# "anthropic" streams real answers; "mock" returns a deterministic cited answer (tests, offline demos)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Optional: a dotenv file outside the repo that holds ANTHROPIC_API_KEY (default: ../.anthropic.env)
# ANTHROPIC_ENV_FILE=/path/to/.anthropic.env

# Local embedding model (ONNX, runs in-process). Changing it requires matching EMBEDDING_DIMENSIONS in the schema.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# Retrieval tuning
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.5
